{
  "expo": {
    "name": "Amodka",
    "slug": "amodka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amodka",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amodka"
    },
    "android": {
      "package": "com.amodka",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3F0",
        "foregroundImage": "./assets/images/icon.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "amodka" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        { "origin": "https://replit.com/" }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Amodka to access your photos to add items to your wardrobe.",
          "cameraPermission": "Allow Amodka to use your camera to photograph wardrobe items."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Amodka uses your location to tailor outfit suggestions to today's weather. You can turn this off anytime in Profile.",
          "locationWhenInUsePermission": "Amodka uses your location to tailor outfit suggestions to today's weather. You can turn this off anytime in Profile."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
