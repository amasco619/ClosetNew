{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package && node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "start": "npx expo start",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "test": "node_modules/.bin/tsx scripts/run-tests.mjs",
    "test:watch": "node scripts/watch-tests.mjs",
    "typecheck": "npx tsc --noEmit",
    "check:images": "node scripts/check-blueprint-images.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@keyv/postgres": "^2.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.83.0",
    "@ungap/structured-clone": "^1.3.0",
    "axios": "^1.14.0",
    "base64-arraybuffer": "^1.0.2",
    "create-launch": "^0.4.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "expo": "~57.0.17",
    "expo-auth-session": "~57.0.16",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.6",
    "http-proxy-middleware": "^3.0.7",
    "keyv": "^5.6.0",
    "pg": "^8.20.0",
    "pngjs": "^7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-purchases": "^10.10.2",
    "react-native-purchases-ui": "^10.10.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^4.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/ngrok": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.4",
    "@types/supertest": "^7.2.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.0",
    "react-test-renderer": "^19.2.3",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "vite": "^7.3.5"
  },
  "private": true
}
